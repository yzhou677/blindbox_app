<?xml version="1.0" encoding="utf-8"?>
<!-- Only files/recovery/ is included; any <include> makes everything else (incl. shared_prefs) excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="recovery/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="recovery/" />
    </device-transfer>
</data-extraction-rules>
